# Puerto donde correrá el servicio
PORT=3300

# Entorno de ejecución
NODE_ENV=production

# Prefijo de la API
API_PREFIX=/api/v1

# Ruta a la base de datos SQLite
DB_PATH=./data/guromensajes.db

# Secret para JWT (genera uno nuevo con: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here_change_in_production

# CORS - Orígenes permitidos (separados por coma)
CORS_ORIGIN=https://guro.co,https://www.guro.co,https://app.guro.co

# Configuración de WhatsApp
WHATSAPP_SESSION_DIR=./auth_info
WHATSAPP_MAX_RETRY_ATTEMPTS=3
WHATSAPP_RETRY_DELAY_MS=5000

# Límites de rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Configuración de uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads

# Logs
LOG_LEVEL=info
LOG_FILE=./logs/whatsapp.log

# Webhook para notificaciones (opcional)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Configuración de base de datos
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_HOURS=24
DB_BACKUP_DIR=./backups

# Configuración de sesión
SESSION_TIMEOUT_MINUTES=30
SESSION_CLEANUP_INTERVAL_MINUTES=60

# Configuración de mensajes
MESSAGE_RETRY_ATTEMPTS=3
MESSAGE_RETRY_DELAY_MS=2000
MESSAGE_QUEUE_ENABLED=true

# Configuración de automatizaciones
AUTOMATION_CHECK_INTERVAL_MS=5000
AUTOMATION_MAX_CONCURRENT=10

# Configuración de WebSocket
WEBSOCKET_ENABLED=true
WEBSOCKET_PATH=/socket.io

# Configuración de seguridad
ENABLE_API_KEY_AUTH=false
API_KEY=

# Configuración de notificaciones
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=