# GURO Backend Production Environment
APP_NAME=GURO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8081
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=guro_prod
DB_USERNAME=guro
DB_PASSWORD=change_me

# Session / Cookies (cross-site frontend https://guro.co <-> http://localhost:8081)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.guro.co
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=false

# Cache / Queue
CACHE_STORE=database
QUEUE_CONNECTION=database

# Redis (opcional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Filesystem
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=change_me
MAIL_FROM_ADDRESS=no-reply@guro.co
MAIL_FROM_NAME="GURO"

# Frontend / CORS / Sanctum
FRONTEND_URL=https://guro.co
SANCTUM_STATEFUL_DOMAINS=guro.co,app.guro.co

# ElevenLabs (si aplica)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TIMEOUT=30

# Employee HS256 Authentication
EMPLOYEE_JWT_SECRET=change_this_in_prod

# Laravel Maintenance Mode backend
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Bcrypt rounds
BCRYPT_ROUNDS=12

# Vite (no aplica en backend API)
VITE_APP_NAME="GURO"

# Extra security headers handled at Nginx (ver deploy/nginx/app.guro.co.conf)

# If behind Cloudflare/Proxy (configure trusted proxies in app if needed)

# Note: generate key after first deploy:
# php artisan key:generate --force