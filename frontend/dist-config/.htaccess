# Vite SPA fallback for guro.co
Options -Indexes

# Force JavaScript MIME type FIRST
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/javascript .mjs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # CRITICAL: Serve static files directly (NO fallback)
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^favicon\.png$ - [L]
  RewriteRule ^env\.js$ - [L]
  
  # Serve ALL files in /assets/ directly - NO SPA fallback
  RewriteRule ^assets/ - [L]

  # Allow existing files/directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback to index.html ONLY for non-existing files
  RewriteRule . /index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
