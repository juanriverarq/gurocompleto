# ============================================
# PLANTILLA DE CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Copia este archivo como .env y configura los valores
# ============================================

# API Backend (Laravel)
# Desarrollo: http://localhost:8081/api
# Producción: http://localhost:8081/api
VITE_API_URL=http://localhost:8081/api

# WhatsApp Microservice
# Desarrollo: http://localhost:3000/api/v1
# Producción: https://whatsapp.guro.co/api/v1
VITE_WHATSAPP_SERVICE_URL=http://localhost:3000/api/v1

# Autenticación de Desarrollo
# true para desarrollo, false para producción
VITE_DEV_AUTH_BYPASS=true
VITE_DEV_BROKER_ID=2

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# DeepSeek API Configuration
VITE_DEEPSEEK_API_KEY=your-deepseek-api-key

# App Configuration
VITE_APP_NAME=Guro
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Node Environment
NODE_ENV=development

# ============================================
# INSTRUCCIONES:
# ============================================
# 1. Copia este archivo como .env para desarrollo local
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. Para producción, usa .env.production con las URLs de producción
# 4. Nunca subas archivos .env con credenciales reales al repositorio
# 5. Reinicia el servidor después de cambiar variables de entorno
