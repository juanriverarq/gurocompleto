import React, { useState, useEffect, useRef, useCallback } from 'react';
import { Card, Button, Badge, Table, Modal, Dropdown, Spinner } from 'flowbite-react';
import { IconDots } from '@tabler/icons-react';
import { Icon } from '@iconify/react';

import { 
  getConversationalAgents, 
  formatCost,
  formatTotalCost,
  formatCostWithProfit
} from '../../../services/elevenLabsService';
import voiceCampaignService from '../../../services/voiceCampaignService';

// CSS personalizado para el slider y modal
const customCSS = `
  /* Base slider input */
  .slider {
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    outline: none;
  }

  /* WebKit/Chromium track */
  .slider::-webkit-slider-runnable-track {
    height: 6px;
    background: #e5e7eb; /* gray-200 */
    border-radius: 9999px;
  }
  .dark .slider::-webkit-slider-runnable-track {
    background: #374151; /* gray-700 */
  }

  /* Firefox track */
  .slider::-moz-range-track {
    height: 6px;
    background: #e5e7eb; /* gray-200 */
    border-radius: 9999px;
  }
  .dark .slider::-moz-range-track {
    background: #374151; /* gray-700 */
  }

  /* Firefox progress (parte izquierda del thumb) */
  .slider::-moz-range-progress {
    height: 6px;
    background: linear-gradient(90deg, #3B82F6, #8B5CF6);
    border-radius: 9999px;
  }

  /* Thumb WebKit */
  .slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    height: 8px; /* 50% más pequeño */
    width: 8px;  /* 50% más pequeño */
    border-radius: 50%;
    background: linear-gradient(45deg, #3B82F6, #8B5CF6);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    margin-top: -1px; /* (thumb 8 - track 6) / 2 */
    border: 2px solid #ffffff;
  }
  .dark .slider::-webkit-slider-thumb {
    border-color: #111827; /* gray-900 */
  }

  /* Thumb Firefox */
  .slider::-moz-range-thumb {
    height: 8px; /* 50% más pequeño */
    width: 8px;  /* 50% más pequeño */
    border-radius: 50%;
    background: linear-gradient(45deg, #3B82F6, #8B5CF6);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    border: 2px solid #ffffff;
  }
  .dark .slider::-moz-range-thumb {
    border-color: #111827;
  }

  /* Ocultar el feo track de IE/Edge antiguo */
  .slider::-ms-track {
    height: 6px;
    background: transparent;
    border-color: transparent;
    color: transparent;
  }

  .call-history-modal { z-index: 9999; }
  .call-history-modal .modal-content { max-width: 95vw; max-height: 95vh; margin: 1rem auto; }
  .call-history-modal .modal-body { padding: 0; }
`;

// Agregar estilos al head
if (typeof document !== 'undefined') {
  const styleSheet = document.createElement('style');
  styleSheet.textContent = customCSS;
  document.head.appendChild(styleSheet);
}

// Interfaces
interface TranscriptMessage {
  role: 'agent' | 'user';
  time_in_call_secs: number;
  message: string;
  source_medium?: string;
  llm_usage?: any;
  tool_calls?: any[];
  feedback?: any;
  interrupted?: boolean;
}

interface CallRecord {
  id: string | number;
  phoneNumber: string;
  customerName: string;
  agentId?: string;
  agentName?: string;
  campaignId?: string | number;
  campaignName?: string;
  status: 'pending' | 'initiated' | 'ringing' | 'answered' | 'in_progress' | 'completed' | 'failed' | 'no_answer' | 'busy' | 'cancelled';
  duration: number;
  messageCount?: number;
  cost?: number;
  startTime: Date;
  endTime?: Date;
  transcript?: TranscriptMessage[] | string;
  sentiment: 'positive' | 'negative' | 'neutral';
  outcome: 'success' | 'failed' | 'no-answer' | 'callback' | 'not-interested' | 'voicemail';
  notes?: string;
  tags: string[];
  recordingUrl?: string;
  hasAudio: boolean;
  hasUserAudio: boolean;
  hasResponseAudio: boolean;
  analysis?: {
    qualityScore: number;
    keyPoints: string[];
  };
  terminationReason?: string;
  customerData?: {
    name?: string;
    email?: string;
    policyNumber?: string;
    debtAmount?: number;
  };
  conversation_id?: string;
  call_recording_url?: string;  // URL de grabación de VAPI
  // Datos híbridos
  is_enriched?: boolean;
  elevenlabs_cost?: number;
  elevenlabs_analysis?: any;
  elevenlabs_metadata?: any;
  elevenlabs_raw?: any;
  metadata?: any;
  // Campos adicionales del backend
  voice_campaign_id?: number;
  execution_id?: number;
  recipient_phone?: string;
  recipient_name?: string;
  call_initiated_at?: Date;
  call_answered_at?: Date;
  call_ended_at?: Date;
  duration_seconds?: number;
  call_result?: any;
  error_message?: string;
  retry_count?: number;
  // Costos del backend con margen por broker
  costs?: {
    currency?: string;
    cop_rate?: number;
    voice_cop?: number;      // Costo voz IA
    phone_cop?: number;      // Costo telefonía
    total_cop?: number;
    total_with_markup_cop?: number;
    total_usd?: number;
    markup_percent?: number;
    billed_minutes?: number;  // Minutos facturados
  };
}

interface CallFilters {
  search: string;
  agent: string;
  status: string;
  outcome: string;
  dateRange: string;
  startDate?: Date;
  endDate?: Date;
  per_page: number;
  page: number;
}

interface PaginationState {
  currentPage: number;
  pageSize: number;
  hasMore: boolean;
  totalDisplayed: number;
  nextCursor?: string;
  total?: number;
}

// Componente principal
const CallHistory: React.FC = () => {
  const TWILIO_RATE_PER_MINUTE = 0.0287;
  const getTwilioFallback = (durationSeconds?: number) => {
    const secs = durationSeconds || 0;
    const minutes = Math.ceil(secs / 60);
    const usd = minutes * TWILIO_RATE_PER_MINUTE;
    return { minutes, usd };
  };
  const [calls, setCalls] = useState<CallRecord[]>([]);
  const [agents, setAgents] = useState<any[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [isLoadingMore, setIsLoadingMore] = useState(false);
  const [selectedCall, setSelectedCall] = useState<CallRecord | null>(null);
  const [isDetailDrawerOpen, setIsDetailDrawerOpen] = useState(false);
  const [error, setError] = useState<string>('');

  // Estados de filtros y paginación
  const [filters, setFilters] = useState<CallFilters>({
    search: '',
    agent: 'all',
    status: 'all',
    outcome: 'all',
    dateRange: 'all',
    per_page: 20,
    page: 1
  });

  const [pagination, setPagination] = useState<PaginationState>({
    currentPage: 1,
    pageSize: 20,
    hasMore: false,
    totalDisplayed: 0,
    total: 0
  });

  // Debounce para búsqueda
  const searchDebounceRef = React.useRef<number | null>(null);

  // Mapeo de estado UI -> backend
  const mapUIStatusToBackend = (value: string): string | undefined => {
    if (!value || value === 'all') return undefined;
    const map: Record<string, string> = {
      'done': 'completed',
      'in-progress': 'in_progress',
      'failed': 'failed',
      'queued': 'pending',
      'completed': 'completed',
      'in_progress': 'in_progress',
      'pending': 'pending',
      'no_answer': 'no_answer',
      'busy': 'busy',
      'cancelled': 'cancelled',
      'initiated': 'initiated',
      'answered': 'answered',
      'ringing': 'ringing'
    };
    return map[value] || value;
  };

  // Columnas visibles
  const [visibleColumns] = useState<string[]>([
    'customer',
    'agent',
    'status',
    'duration',
    'outcome',
    'cost'
  ]);

  // Estados de audio - restaurar funcionalidad completa
  const [isPlayingAudio, setIsPlayingAudio] = useState(false);
  const [currentAudio, setCurrentAudio] = useState<HTMLAudioElement | null>(null);
  const [isLoadingAudio, setIsLoadingAudio] = useState(false);
  const [audioUrl, setAudioUrl] = useState<string | null>(null);
  const [audioDuration, setAudioDuration] = useState(0);
  const [currentTime, setCurrentTime] = useState(0);
  const [volume, setVolume] = useState(1);

  // Tab activo en el drawer
  const [activeTab, setActiveTab] = useState('overview');

  // Cargar datos iniciales
  useEffect(() => {
    loadInitialData();
  }, []);

  const loadInitialData = async () => {
    setIsLoading(true);
    try {
      const [agentsData] = await Promise.all([
        getConversationalAgents().catch(() => [])
      ]);

      setAgents(Array.isArray(agentsData) ? agentsData : []);
      await loadConversations(true);
    } catch (error) {
      setError('Error al cargar datos iniciales');
    } finally {
      setIsLoading(false);
    }
  };

  const loadConversations = async (reset: boolean = false, newFilters?: Partial<CallFilters>, targetPage?: number) => {
    if (reset) {
      setIsLoading(true);
      setPagination(prev => ({ ...prev, currentPage: 1, totalDisplayed: 0 }));
    } else {
      setIsLoadingMore(true);
    }

    try {
      const filtersToUse = newFilters || filters;
      const pageToLoad = targetPage ?? (reset ? 1 : pagination.currentPage);
      const pageSize = pagination.pageSize;
      const requestFilters: any = {
        limit: pageSize,
        offset: (pageToLoad - 1) * pageSize
      };

      if (filtersToUse.status && filtersToUse.status !== 'all') {
        const backendStatus = mapUIStatusToBackend(filtersToUse.status);
        if (backendStatus) requestFilters.status = backendStatus;
      }

      if (filtersToUse.search && filtersToUse.search.trim()) {
        requestFilters.phone = filtersToUse.search.trim();
      }

      if (filtersToUse.startDate && filtersToUse.endDate) {
        requestFilters.date_from = filtersToUse.startDate.toISOString().split('T')[0];
        requestFilters.date_to = filtersToUse.endDate.toISOString().split('T')[0];
      }

      // Filtro por agente (usa agent_id del backend)
      if (filtersToUse.agent && filtersToUse.agent !== 'all') {
        requestFilters.agent_id = filtersToUse.agent;
      }

      console.log('🔄 [CALL HISTORY] Loading calls with filters:', requestFilters);

      // Lista sin enriquecer (mejor rendimiento). El detalle se enriquece on-demand.
      const result = await voiceCampaignService.getHybridCallHistory({ ...requestFilters, enrich: false } as any);
      
      if (!result || !result.success || !result.calls) {
        if (reset) {
          setCalls([]);
        }
        if (result?.message) {
          setError(result.message);
        }
        return;
      }

      console.log('✅ [CALL HISTORY] Hybrid calls loaded successfully:', result);
      
      // Mostrar información sobre el enriquecimiento
      if (result.metadata) {
        console.log(`📊 [HYBRID] Enrichment stats: ${result.metadata.enriched_calls}/${result.metadata.total_calls} calls enriched with ElevenLabs data`);
      }

      // Transformar datos del backend a nuestro formato
      const transformedCalls: CallRecord[] = result.calls.map((call: any) => {
        const elStatus = call?.elevenlabs?.raw?.status || call?.elevenlabs_status || call?.elevenlabs_metadata?.status;
        const finalStatus = mapBackendStatus(elStatus || call.status);
        const elCallSuccessful = (call?.elevenlabs_analysis?.call_successful ?? call?.elevenlabs?.raw?.analysis?.call_successful);
        let outcomeFromAnalysis: 'success' | 'failed' | undefined = undefined;
        if (typeof elCallSuccessful === 'boolean') {
          outcomeFromAnalysis = elCallSuccessful ? 'success' : 'failed';
        } else if (typeof elCallSuccessful === 'string') {
          const lc = elCallSuccessful.toLowerCase();
          if (lc === 'success' || lc === 'successful' || lc === 'completed' || lc === 'done') {
            outcomeFromAnalysis = 'success';
          } else if (lc === 'failed' || lc === 'failure' || lc === 'error') {
            outcomeFromAnalysis = 'failed';
          }
        }

        // Normalizar transcript desde ElevenLabs o VAPI
        const rawTranscript = call?.elevenlabs_raw?.transcript || call?.elevenlabs?.raw?.transcript || call?.call_transcript;
        let normalizedTranscript: TranscriptMessage[] | undefined = undefined;
        
        if (Array.isArray(rawTranscript)) {
          // Ya es un array (ElevenLabs format)
          normalizedTranscript = rawTranscript.map((m: any) => ({
            role: (m.role || m.speaker || 'agent') as 'agent' | 'user',
            time_in_call_secs: Number(m.time_in_call_secs || m.time || 0),
            message: m.message || m.content || m.text || '',
            source_medium: m.source_medium,
            tool_calls: m.tool_calls || [],
            feedback: m.feedback || undefined,
            interrupted: m.interrupted || false,
          }));
        } else if (typeof rawTranscript === 'string' && rawTranscript.trim()) {
          // Es un string (VAPI format: "AI: mensaje\nUser: mensaje\n...")
          // Parsear el formato de VAPI
          const lines = rawTranscript.split('\n').filter((line: string) => line.trim());
          let timeCounter = 0;
          normalizedTranscript = lines.map((line: string) => {
            const isAgent = line.startsWith('AI:') || line.startsWith('Agente:') || line.startsWith('Agent:');
            const isUser = line.startsWith('User:') || line.startsWith('Usuario:') || line.startsWith('Cliente:');
            
            let message = line;
            let role: 'agent' | 'user' = 'agent';
            
            if (isAgent) {
              role = 'agent';
              message = line.replace(/^(AI|Agente|Agent):\s*/i, '');
            } else if (isUser) {
              role = 'user';
              message = line.replace(/^(User|Usuario|Cliente):\s*/i, '');
            }
            
            timeCounter += 5; // Aproximar 5 segundos por mensaje
            
            return {
              role,
              time_in_call_secs: timeCounter,
              message: message.trim(),
              source_medium: undefined,
              tool_calls: [],
              feedback: undefined,
              interrupted: false,
            };
          });
        }

        return {
          id: call.id,
          phoneNumber: call.recipient_phone || 'N/A',
          customerName: call.recipient_name || 'Cliente sin nombre',
          agentId: call.agent_id || call.voice_campaign?.elevenlabs_agent_id || '',
          agentName: call.agent_name || call.voice_campaign?.agent_name || 'Agente desconocido',
          campaignId: call.voice_campaign_id,
          campaignName: call.voice_campaign?.name || '',
          status: finalStatus,
          duration: call.duration_seconds || 0,
          messageCount: 0, // No disponible en el backend actual
          cost: call.costs?.total_with_markup_usd || call.costs?.total_usd || 0,
          startTime: call.call_initiated_at ? new Date(call.call_initiated_at) : new Date(call.created_at),
          endTime: call.call_ended_at ? new Date(call.call_ended_at) : undefined,
          transcript: normalizedTranscript || call.call_transcript || '',
          sentiment: 'neutral', // Por defecto
          outcome: outcomeFromAnalysis || mapBackendOutcome((typeof call.call_result === 'string' ? call.call_result : call.call_result?.result) || call.status),
          notes: call.error_message || '',
          tags: generateTagsFromCall(call),
          hasAudio: !!call.call_recording_url || !!call.elevenlabs_conversation_id,
          hasUserAudio: !!call.call_recording_url,
          hasResponseAudio: !!call.call_recording_url,
          analysis: undefined,
          terminationReason: call.error_message || undefined,
          customerData: call.call_metadata || {},
          conversation_id: call.elevenlabs_conversation_id ? String(call.elevenlabs_conversation_id) : undefined,
          call_recording_url: call.call_recording_url || undefined,
          // Campos adicionales del backend
          voice_campaign_id: call.voice_campaign_id,
          execution_id: call.voice_campaign_execution_id,
          recipient_phone: call.recipient_phone,
          recipient_name: call.recipient_name,
          call_initiated_at: call.call_initiated_at ? new Date(call.call_initiated_at) : undefined,
          call_answered_at: call.call_answered_at ? new Date(call.call_answered_at) : undefined,
          call_ended_at: call.call_ended_at ? new Date(call.call_ended_at) : undefined,
          duration_seconds: call.duration_seconds,
          call_result: call.call_result,
          error_message: call.error_message,
          retry_count: call.retry_count || 0,
          // Datos híbridos de ElevenLabs
          is_enriched: call.is_enriched || false,
          elevenlabs_cost: call.elevenlabs_cost || 0,
          elevenlabs_analysis: call.elevenlabs_analysis || null,
          elevenlabs_metadata: call.elevenlabs_metadata || null,
          elevenlabs_raw: call.elevenlabs?.raw || null,
          // Datos recolectados del tool (NUEVO)
          collected_data: call.collected_data || null,
          call_metadata: call.call_metadata || null,
          // Costos del backend con margen por broker (si existen)
          costs: call.costs ? {
            currency: call.costs.currency,
            cop_rate: call.costs.cop_rate,
            voice_cop: call.costs.voice_cop || 0,      // Costo voz IA
            phone_cop: call.costs.phone_cop || 0,      // Costo telefonía
            total_cop: call.costs.total_cop || 0,
            total_with_markup_cop: call.costs.total_with_markup_cop || 0,
            total_usd: call.costs.total_usd || 0,
            markup_percent: call.costs.markup_percent || 0,
            billed_minutes: call.costs.billed_minutes || 0,
          } : undefined
        };
      });

      // Aplicar filtros de fallback en frontend (por si el backend no filtra todo)
      let finalCalls = [...transformedCalls];
      if (filtersToUse?.agent && filtersToUse.agent !== 'all') {
        finalCalls = finalCalls.filter(c => (c.agentId || '').trim() === (filtersToUse.agent || '').trim());
      }
      if (filtersToUse?.status && filtersToUse.status !== 'all') {
        const backendStatus = mapUIStatusToBackend(filtersToUse.status!);
        if (backendStatus) finalCalls = finalCalls.filter(c => (c.status || '') === backendStatus);
      }

      // Reemplazar resultados de la página (no concatenar)
      setCalls(finalCalls);

      // Si abrimos detalles y hay transcripción, activar la pestaña transcript por claridad visual
      // (no cambia automáticamente la pestaña si no hay un detalle abierto)
      if (isDetailDrawerOpen && selectedCall) {
        const refreshed = transformedCalls.find(c => c.id === selectedCall.id);
        if (refreshed && Array.isArray(refreshed.transcript) && refreshed.transcript.length > 0) {
          setActiveTab('transcript');
        }
      }

      const total = result.total || 0;
      const hasMore = total > pageToLoad * pageSize;

      setPagination(prev => ({
        ...prev,
        hasMore,
        totalDisplayed: finalCalls.length,
        currentPage: pageToLoad,
        total
      }));

    } catch (error) {
      console.error('❌ [CALL HISTORY] Error loading calls:', error);
      setError('Error al cargar el historial de llamadas. Verifique su conexión.');
      
      if (reset) {
        setCalls([]);
      }
    } finally {
      setIsLoading(false);
      setIsLoadingMore(false);
    }
  };

  const handleFilterChange = (key: keyof CallFilters, value: any) => {
    setFilters(prev => ({ ...prev, [key]: value }));
  };

  const handleSearch = () => {
    loadConversations(true, undefined, 1);
  };

  const analyzeSentiment = (_transcript: any): 'positive' | 'negative' | 'neutral' => {
    if (Array.isArray(_transcript) && _transcript.length > 0) {
      return 'positive';
    }
    return 'neutral';
  };

  const generateTags = (_conversation: any): string[] => {
    const tags: string[] = [];
    
    if (_conversation.outcome === 'success') tags.push('exitosa');
    if (_conversation.duration && _conversation.duration > 300) tags.push('larga');
    if (_conversation.duration && _conversation.duration < 60) tags.push('corta');
    if (_conversation.cost && _conversation.cost > 1) tags.push('alto-costo');
    
    return tags;
  };

  // Función para mapear estados del backend a los del frontend
  const mapBackendStatus = (backendStatus: string): CallRecord['status'] => {
    const statusMap: Record<string, CallRecord['status']> = {
      'pending': 'pending',
      'initiated': 'initiated',
      'ringing': 'ringing',
      'answered': 'answered',
      'in_progress': 'in_progress',
      'completed': 'completed',
      'done': 'completed',
      'success': 'completed',
      'processing': 'in_progress',
      'running': 'in_progress',
      'queued': 'pending',
      'failed': 'failed',
      'no_answer': 'no_answer',
      'busy': 'busy',
      'cancelled': 'cancelled'
    };
    return statusMap[backendStatus] || 'failed';
  };

  // Función para mapear resultados del backend a outcomes del frontend
  const mapBackendOutcome = (backendResult: string): CallRecord['outcome'] => {
    const outcomeMap: Record<string, CallRecord['outcome']> = {
      'success': 'success',
      'completed': 'success',
      'failed': 'failed',
      'no_answer': 'no-answer',
      'busy': 'no-answer',
      'invalid_number': 'failed',
      'network_error': 'failed',
      'api_error': 'failed',
      'rejected': 'not-interested',
      'voicemail': 'voicemail'
    };
    return outcomeMap[backendResult] || 'failed';
  };

  // Función para generar tags basados en datos del backend
  const generateTagsFromCall = (call: any): string[] => {
    const tags: string[] = [];
    
    if (call.call_result === 'completed' || call.call_result === 'successful' || call.call_result === 'answered' || call.status === 'completed') {
    tags.push('exitosa');
  }
    if (call.duration_seconds && call.duration_seconds > 300) tags.push('larga');
    if (call.duration_seconds && call.duration_seconds < 60) tags.push('corta');
    if (call.retry_count && call.retry_count > 0) tags.push('reintentada');
    if (call.error_message) tags.push('error');
    if (call.is_enriched) tags.push('enriquecida');
    
    return tags;
  };

  const getColumnName = (columnKey: string): string => {
    const columnNames: Record<string, string> = {
      customer: 'Cliente',
      agent: 'Agente',
      status: 'Estado',
      duration: 'Duración',
      outcome: 'Resultado',
      cost: 'Costo',
      startTime: 'Fecha',
      phone: 'Teléfono'
    };
    return columnNames[columnKey] || columnKey;
  };

  const renderTableCell = (call: CallRecord, columnKey: string) => {
    switch (columnKey) {
      case 'customer':
        return (
          <div>
            <div className="font-medium text-gray-900 dark:text-white">
              {call.customerName}
            </div>
            <div className="text-sm text-gray-500">{call.phoneNumber}</div>
          </div>
        );
      case 'agent':
        return (
          <div className="flex items-center gap-2">
            <div className="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
              <Icon icon="solar:users-group-rounded-bold-duotone" className="w-4 h-4 text-blue-600" />
            </div>
            <span className="font-medium">{call.agentName}</span>
          </div>
        );
      case 'status':
        return <Badge color={getStatusColor(call.status)}>{getStatusLabel(call.status)}</Badge>;
      case 'duration':
        return (
          <div className="flex items-center gap-2">
            <Icon icon="solar:clock-circle-bold-duotone" className="w-4 h-4 text-gray-400" />
            <span>{formatDuration(call.duration)}</span>
          </div>
        );
      case 'outcome': {
        const rawResult = (typeof (call as any).call_result === 'string' ? (call as any).call_result : undefined) || call.status;
        return <Badge color={getStatusColor(rawResult)}>{getStatusLabel(rawResult)}</Badge>;
      }
      case 'cost': {
        const amount = call.costs
          ? Number((call.costs as any).total_with_markup_cop ?? (call.costs as any).total_cop ?? 0)
          : 0;
        const totalCOP = `COP ${amount.toFixed(2)}`;
        return (
          <div className="flex items-center gap-2">
            <Icon icon="solar:wallet-money-bold-duotone" className="w-4 h-4 text-purple-400" />
            <span className="font-medium">{totalCOP}</span>
          </div>
        );
      }
      case 'startTime':
        return (
          <div className="text-sm">
            <div>{new Date(call.startTime).toLocaleDateString()}</div>
            <div className="text-gray-500">{new Date(call.startTime).toLocaleTimeString()}</div>
          </div>
        );
      default:
        return null;
    }
  };

  const getStatusColor = (status: string) => {
    switch (status) {
      case 'completed': return 'success';
      case 'done': return 'success';
      case 'failed': return 'failure';
      case 'in_progress': return 'warning';
      case 'in-progress': return 'warning';
      case 'answered': return 'warning';
      case 'initiated': return 'info';
      case 'ringing': return 'info';
      case 'pending': return 'info';
      case 'queued': return 'info';
      case 'no_answer': return 'gray';
      case 'busy': return 'gray';
      case 'cancelled': return 'gray';
      default: return 'gray';
    }
  };

  const getStatusLabel = (status: string) => {
    const labels: Record<string, string> = {
      'completed': 'Completada',
      'done': 'Completada',
      'failed': 'Fallida',
      'in_progress': 'En progreso',
      'in-progress': 'En progreso',
      'answered': 'Contestada',
      'initiated': 'Iniciada',
      'ringing': 'Sonando',
      'pending': 'Pendiente',
      'queued': 'En cola',
      'no_answer': 'Sin respuesta',
      'busy': 'Ocupado',
      'voicemail': 'Buzón',
      'cancelled': 'Cancelada'
    };
    return labels[status] || status;
  };

  const getOutcomeColor = (outcome: string) => {
    switch (outcome) {
      case 'success': return 'success';
      case 'failed': return 'failure';
      case 'callback': return 'warning';
      case 'not-interested': return 'gray';
      default: return 'info';
    }
  };

  const getOutcomeLabel = (outcome: string) => {
    const labels: Record<string, string> = {
      'success': 'Éxito',
      'failed': 'Fallida',
      'no-answer': 'Sin respuesta',
      'callback': 'Callback',
      'not-interested': 'No interesado',
      'voicemail': 'Buzón'
    };
    return labels[outcome] || outcome;
  };

  const formatDuration = (seconds: number): string => {
    const minutes = Math.floor(seconds / 60);
    const remainingSeconds = seconds % 60;
    return `${minutes}:${remainingSeconds.toString().padStart(2, '0')}`;
  };

  const handleViewCall = (call: CallRecord) => {
    // Limpiar audio anterior si existe
    cleanupAudio();
    
    setSelectedCall(call);
    setIsDetailDrawerOpen(true);
  };

  // Precargar audio (sin reproducir) al abrir la modal si hay conversation_id
  useEffect(() => {
    const preload = async () => {
      if (isDetailDrawerOpen && selectedCall?.conversation_id) {
        try {
          setIsLoadingAudio(true);
          const { getConversationAudio } = await import('../../../services/elevenLabsService');
          const audioUrl = await getConversationAudio(selectedCall.conversation_id);
          if (audioUrl) {
            const audio = new Audio(audioUrl);
            audio.preload = 'metadata';
            audio.volume = volume;
            // listeners: metadata y progreso para reflejar barra
            audio.addEventListener('loadedmetadata', () => setAudioDuration(audio.duration));
            audio.addEventListener('timeupdate', () => {
              if (!isSeekingRef.current) setCurrentTime(audio.currentTime);
            });
            audio.addEventListener('ended', () => {
              setIsPlayingAudio(false);
              setCurrentTime(0);
            });
            audio.addEventListener('error', () => {
              setIsPlayingAudio(false);
            });
            setCurrentAudio(audio);
            setAudioUrl(audioUrl);
            setIsPlayingAudio(false); // no reproducir automáticamente
          }
        } catch (_) {
        } finally {
          setIsLoadingAudio(false);
        }
      }
    };
    preload();
  }, [isDetailDrawerOpen, selectedCall?.conversation_id]);

  // Función para limpiar el audio completamente
  const cleanupAudio = () => {
    if (currentAudio) {
      currentAudio.pause();
      currentAudio.currentTime = 0;
      // Remover todos los event listeners
      currentAudio.removeEventListener('loadedmetadata', () => {});
      currentAudio.removeEventListener('timeupdate', () => {});
      currentAudio.removeEventListener('ended', () => {});
      currentAudio.removeEventListener('error', () => {});
      setCurrentAudio(null);
    }
    
    // Limpiar URL del audio para liberar memoria
    if (audioUrl) {
      URL.revokeObjectURL(audioUrl);
      setAudioUrl(null);
    }
    
    // Resetear estados de audio
    setIsPlayingAudio(false);
    setIsLoadingAudio(false);
    setAudioDuration(0);
    setCurrentTime(0);
  };

  const clearFilters = () => {
    setFilters({
      search: '',
      agent: 'all',
      status: 'all',
      outcome: 'all',
      dateRange: 'all',
      per_page: 20,
      page: 1
    });
    loadConversations(true);
  };

  const getActiveFiltersCount = () => {
    let count = 0;
    if (filters.search) count++;
    if (filters.agent !== 'all') count++;
    if (filters.status !== 'all') count++;
    if (filters.outcome !== 'all') count++;
    if (filters.dateRange !== 'all') count++;
    return count;
  };

  // Función para reproducir audio
  const handlePlayAudio = async (call: CallRecord) => {
    setIsLoadingAudio(true);
    try {
      // Si ya hay audio precargado, asegurar listeners y reproducir
      if (currentAudio) {
        currentAudio.addEventListener('timeupdate', () => {
          if (!isSeekingRef.current) setCurrentTime(currentAudio.currentTime);
        });
        currentAudio.addEventListener('ended', () => { setIsPlayingAudio(false); setCurrentTime(0); });
        currentAudio.addEventListener('error', () => { setIsPlayingAudio(false); });
        await currentAudio.play();
        setIsPlayingAudio(true);
        return;
      }

      // Primero intentar usar la URL de grabación de VAPI (guardada en call_recording_url)
      let audioUrl: string | null = null;
      
      // Prioridad 1: URL de grabación directa de VAPI
      if (call.call_recording_url) {
        audioUrl = call.call_recording_url;
        console.log('🎵 Usando URL de grabación de VAPI:', audioUrl);
      }
      // Prioridad 2: Intentar obtener desde ElevenLabs si hay conversation_id
      else if (call.conversation_id) {
        try {
          const { getConversationAudio } = await import('../../../services/elevenLabsService');
          audioUrl = await getConversationAudio(call.conversation_id);
          console.log('🎵 Obtenido audio desde ElevenLabs:', audioUrl ? 'OK' : 'No disponible');
        } catch (e) {
          console.warn('⚠️ No se pudo obtener audio de ElevenLabs:', e);
        }
      }

      if (!audioUrl) {
        alert('El audio de esta llamada aún no está disponible. VAPI puede tardar unos minutos en procesarlo.');
        return;
      }

      const audio = new Audio(audioUrl);
      setCurrentAudio(audio);
      setAudioUrl(audioUrl);

      audio.addEventListener('loadedmetadata', () => {
        setAudioDuration(audio.duration);
      });
      audio.addEventListener('timeupdate', () => {
        if (!isSeekingRef.current) setCurrentTime(audio.currentTime);
      });
      audio.addEventListener('ended', () => {
        setIsPlayingAudio(false);
        setCurrentTime(0);
      });
      audio.addEventListener('error', () => {
        setIsPlayingAudio(false);
        alert('Error al reproducir el audio de la conversación');
      });

      audio.volume = volume;
      await audio.play();
      setIsPlayingAudio(true);
    } catch (error) {
      alert('Error al cargar el audio de la conversación');
    } finally {
      setIsLoadingAudio(false);
    }
  };

  // Función para pausar/reanudar audio
  const togglePlayPause = async () => {
    if (!currentAudio) return;
    
    if (isPlayingAudio) {
      currentAudio.pause();
      setIsPlayingAudio(false);
    } else {
      await currentAudio.play();
      setIsPlayingAudio(true);
    }
  };

  // Cambiar posición de reproducción desde slider (robusto frente a timeupdate)
  const isSeekingRef = React.useRef(false);
  const handleProgressChange = (value: number) => {
    if (!currentAudio) return;
    isSeekingRef.current = true;
    const duration = audioDuration || currentAudio.duration || 0;
    const target = Math.max(0, Math.min(value, duration));
    currentAudio.currentTime = target;
    setCurrentTime(target);
    // relajar el flag ligeramente después
    setTimeout(() => { isSeekingRef.current = false; }, 50);
  };

  // Adelantar/retroceder N segundos
  const skipSeconds = (delta: number) => {
    if (!currentAudio) return;
    const duration = audioDuration || currentAudio.duration || 0;
    const nextTime = Math.max(0, Math.min((currentAudio.currentTime || 0) + delta, duration));
    currentAudio.currentTime = nextTime;
    setCurrentTime(nextTime);
  };

  // Barras de progreso (seek) y volumen sin thumb
  const progressBarRef = React.useRef<HTMLDivElement | null>(null);
  const volumeBarRef = React.useRef<HTMLDivElement | null>(null);

  const setSeekByClientX = (clientX: number) => {
    if (!currentAudio || !progressBarRef.current) return;
    const rect = progressBarRef.current.getBoundingClientRect();
    const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    const duration = audioDuration || currentAudio.duration || 0;
    const target = ratio * duration;
    currentAudio.currentTime = target;
    setCurrentTime(target);
  };

  const handleProgressBarMouseDown = (e: React.MouseEvent) => {
    isSeekingRef.current = true;
    setSeekByClientX(e.clientX);
    const onMove = (ev: MouseEvent) => setSeekByClientX(ev.clientX);
    const onUp = () => {
      isSeekingRef.current = false;
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
    };
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
  };

  const handleProgressBarTouchStart = (e: React.TouchEvent) => {
    if (!e.touches || e.touches.length === 0) return;
    isSeekingRef.current = true;
    setSeekByClientX(e.touches[0].clientX);
    const onMove = (ev: TouchEvent) => {
      if (ev.touches && ev.touches.length > 0) setSeekByClientX(ev.touches[0].clientX);
    };
    const onEnd = () => {
      isSeekingRef.current = false;
      document.removeEventListener('touchmove', onMove);
      document.removeEventListener('touchend', onEnd);
      document.removeEventListener('touchcancel', onEnd);
    };
    document.addEventListener('touchmove', onMove);
    document.addEventListener('touchend', onEnd);
    document.addEventListener('touchcancel', onEnd);
  };

  const setVolumeByClientX = (clientX: number) => {
    const ref = volumeBarRef.current;
    if (!ref) return;
    const rect = ref.getBoundingClientRect();
    const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    setVolume(ratio);
    if (currentAudio) currentAudio.volume = ratio;
  };

  const handleVolumeBarMouseDown = (e: React.MouseEvent) => {
    setVolumeByClientX(e.clientX);
    const onMove = (ev: MouseEvent) => setVolumeByClientX(ev.clientX);
    const onUp = () => {
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
    };
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
  };

  const handleVolumeBarTouchStart = (e: React.TouchEvent) => {
    if (!e.touches || e.touches.length === 0) return;
    setVolumeByClientX(e.touches[0].clientX);
    const onMove = (ev: TouchEvent) => {
      if (ev.touches && ev.touches.length > 0) setVolumeByClientX(ev.touches[0].clientX);
    };
    const onEnd = () => {
      document.removeEventListener('touchmove', onMove);
      document.removeEventListener('touchend', onEnd);
      document.removeEventListener('touchcancel', onEnd);
    };
    document.addEventListener('touchmove', onMove);
    document.addEventListener('touchend', onEnd);
    document.addEventListener('touchcancel', onEnd);
  };

  // Actualizar volumen cuando cambie el slider
  useEffect(() => {
    if (currentAudio) {
      currentAudio.volume = volume;
    }
  }, [volume, currentAudio]);

  // Limpiar audio cuando se cierre el modal o cambie selectedCall
  useEffect(() => {
    if (!selectedCall || !isDetailDrawerOpen) {
      cleanupAudio();
    }
  }, [selectedCall, isDetailDrawerOpen]);

  // Función para descargar transcripción
  const handleDownloadTranscript = (_call: CallRecord) => {
    try {
      let content = `Transcripción de Conversación\n`;
      content += `================================\n`;
      content += `Cliente: ${_call.customerName}\n`;
      content += `Teléfono: ${_call.phoneNumber}\n`;
      content += `Agente: ${_call.agentName}\n`;
      content += `Fecha: ${new Date(_call.startTime).toLocaleString()}\n`;
      content += `Duración: ${formatDuration(_call.duration)}\n`;
      content += `================================\n\n`;

      if (Array.isArray(_call.transcript)) {
        _call.transcript.forEach((message: TranscriptMessage, index: number) => {
          const time = Math.floor(message.time_in_call_secs / 60) + ':' + 
                      String(message.time_in_call_secs % 60).padStart(2, '0');
          content += `[${time}] ${message.role === 'agent' ? 'Agente' : 'Cliente'}: ${message.message}\n\n`;
        });
      } else if (typeof _call.transcript === 'string') {
        content += _call.transcript;
      } else {
        content += 'Transcripción no disponible';
      }

      const blob = new Blob([content], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `transcripcion_${_call.customerName}_${new Date(_call.startTime).toISOString().split('T')[0]}.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch (error) {
      alert('Error al descargar la transcripción');
    }
  };

  if (isLoading && calls.length === 0) {
    return (
      <div className="flex flex-col items-center justify-center h-64 space-y-4">
        <Spinner size="lg" />
        <p className="text-gray-600">Cargando conversaciones reales...</p>
      </div>
    );
  }

  // Estado vacío
  if (!isLoading && calls.length === 0) {
    return (
      <div className="space-y-6">
        {/* Header */}
        <div className="bg-white dark:bg-darkgray shadow-md dark:shadow-none rounded-[10px]">
          <div className="p-6 border-b border-gray-100 dark:border-gray-700">
            <div className="flex flex-col lg:flex-row gap-4">
              <div className="flex-1">
                <div className="relative">
                  <Icon icon="solar:magnifer-bold-duotone" className="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" />
                  <input
                    type="text"
                    placeholder="Buscar por teléfono, cliente, agente..."
                    value={filters.search}
                    onChange={(e) => handleFilterChange('search', e.target.value)}
                    className="pl-10 h-10 text-sm rounded-[10px] w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800"
                  />
                </div>
              </div>
              <div className="flex gap-2">
                <Button 
                  onClick={handleSearch}
                  className="h-10 px-4 bg-blue-600 hover:bg-blue-700 rounded-[10px]"
                >
                  <Icon icon="solar:magnifer-bold-duotone" className="w-4 h-4 mr-2" />
                  Buscar
                </Button>
              </div>
            </div>
          </div>
        </div>

        {/* Estado vacío */}
        <Card className="p-12">
          <div className="text-center">
            <Icon icon="solar:phone-calling-rounded-outline" className="w-20 h-20 text-gray-300 mx-auto mb-6" />
            <h3 className="text-xl font-semibold text-gray-600 mb-3">
              Sin conversaciones registradas
            </h3>
            <p className="text-gray-500 mb-6 max-w-lg mx-auto">
              No hay llamadas en el sistema. Las conversaciones aparecerán aquí cuando se realicen las primeras llamadas con agentes de ElevenLabs.
            </p>
            {error && (
              <div className="bg-red-50 border border-red-200 rounded-lg p-4 mb-6 max-w-md mx-auto">
                <div className="flex items-center gap-2">
                  <Icon icon="solar:danger-circle-bold" className="w-5 h-5 text-red-500" />
                  <p className="text-red-600 text-sm font-medium">Error de conexión</p>
                </div>
                <p className="text-red-600 text-sm mt-1">{error}</p>
              </div>
            )}
            <div className="flex flex-col sm:flex-row gap-3 justify-center">
              <Button onClick={handleSearch} className="bg-blue-600 hover:bg-blue-700">
                <Icon icon="solar:refresh-bold-duotone" className="w-4 h-4 mr-2" />
                Actualizar
              </Button>
            </div>
          </div>
        </Card>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      {/* Header con búsqueda y filtros */}
      <div className="bg-white dark:bg-darkgray shadow-md dark:shadow-none rounded-[10px]">
        <div className="p-6 border-b border-gray-100 dark:border-gray-700">
          <div className="flex flex-col lg:flex-row gap-4">
            <div className="flex-1">
              <div className="relative">
                <Icon icon="solar:magnifer-bold-duotone" className="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" />
                <input
                  type="text"
                  placeholder="Buscar por teléfono, cliente, agente..."
                  value={filters.search}
                  onChange={(e) => handleFilterChange('search', e.target.value)}
                  className="pl-10 h-10 text-sm rounded-[10px] w-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800"
                />
              </div>
            </div>
            
            <div className="flex gap-2">
              <select
                value={filters.agent}
                onChange={(e) => handleFilterChange('agent', e.target.value)}
                className="h-10 text-sm rounded-[10px] border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800"
              >
                <option value="all">Todos los agentes</option>
                {agents.map(agent => (
                  <option key={agent.id} value={agent.id}>
                    {agent.name}
                  </option>
                ))}
              </select>
              
              <select
                value={filters.status}
                onChange={(e) => handleFilterChange('status', e.target.value)}
                className="h-10 text-sm rounded-[10px] border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-800"
              >
                <option value="all">Todos los estados</option>
                <option value="done">Completadas</option>
                <option value="failed">Fallidas</option>
                <option value="in-progress">En progreso</option>
              </select>

              <Button 
                onClick={handleSearch}
                className="h-10 px-4 bg-blue-600 hover:bg-blue-700 rounded-[10px]"
              >
                <Icon icon="solar:magnifer-bold-duotone" className="w-4 h-4 mr-2" />
                Buscar
              </Button>
              
              {getActiveFiltersCount() > 0 && (
                <Button 
                  onClick={clearFilters}
                  color="light"
                  className="h-10 px-4 rounded-[10px]"
                >
                  <Icon icon="solar:refresh-bold-duotone" className="w-4 h-4 mr-2" />
                  Limpiar
                </Button>
              )}
            </div>
          </div>
        </div>

        <div className="p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div className="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400">
            <div className="flex items-center gap-2">
              <Icon icon="solar:phone-calling-rounded-bold-duotone" className="w-4 h-4" />
              <span>
                Mostrando {(pagination.currentPage - 1) * pagination.pageSize + 1}
                {' '}a{' '}
                {Math.min(pagination.currentPage * pagination.pageSize, pagination.total || calls.length)}
                {' '}de{' '}
                {pagination.total || calls.length} resultados
              </span>
            </div>
            {getActiveFiltersCount() > 0 && (
              <div className="flex items-center gap-2">
                <Icon icon="solar:filter-bold-duotone" className="w-4 h-4" />
                <span>{getActiveFiltersCount()} filtro{getActiveFiltersCount() > 1 ? 's' : ''} activo{getActiveFiltersCount() > 1 ? 's' : ''}</span>
              </div>
            )}
          </div>
        </div>
      </div>

      {/* Tabla de llamadas */}
      <Card>
        {/* Vista de tabla para pantallas grandes */}
        <div className="hidden lg:block overflow-x-auto">
          <Table hoverable className="shadow-md dark:shadow-none bg-white dark:bg-darkgray rounded-[10px]">
            <Table.Head>
              {visibleColumns.map((columnKey) => (
                <Table.HeadCell key={columnKey}>
                  {getColumnName(columnKey)}
                </Table.HeadCell>
              ))}
              <Table.HeadCell>Acciones</Table.HeadCell>
            </Table.Head>
            <Table.Body>
              {calls.map((call) => (
                <Table.Row key={call.id}>
                  {visibleColumns.map((columnKey) => (
                    <Table.Cell key={columnKey} className="whitespace-nowrap">
                      {renderTableCell(call, columnKey)}
                    </Table.Cell>
                  ))}
                  <Table.Cell>
                    <Dropdown
                      label=""
                      dismissOnClick={false}
                      renderTrigger={() => (
                        <span className="h-9 w-9 flex justify-center items-center rounded-full hover:bg-lightprimary hover:text-primary cursor-pointer">
                          <IconDots size={22} />
                        </span>
                      )}
                    >
                      <Dropdown.Item 
                        className="flex gap-3"
                        onClick={() => handleViewCall(call)}
                      >
                        <Icon icon="solar:eye-bold-duotone" height={18} />
                        <span>Ver Detalles</span>
                      </Dropdown.Item>
                      {call.hasAudio && (
                        <Dropdown.Item className="flex gap-3">
                          <Icon icon="solar:play-bold-duotone" height={18} />
                          <span>Reproducir Audio</span>
                        </Dropdown.Item>
                      )}
                      <Dropdown.Item className="flex gap-3">
                        <Icon icon="solar:download-bold-duotone" height={18} />
                        <span>Descargar Transcripción</span>
                      </Dropdown.Item>
                    </Dropdown>
                  </Table.Cell>
                </Table.Row>
              ))}
            </Table.Body>
          </Table>
        </div>

        {/* Vista de cards para móviles */}
        <div className="lg:hidden space-y-4">
          {calls.map((call) => (
            <Card key={call.id} className="p-4">
              <div className="flex items-start justify-between mb-3">
                <div className="flex items-center gap-2">
                  <div className="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                    <Icon icon="solar:phone-calling-rounded-bold-duotone" className="w-4 h-4 text-blue-600" />
                  </div>
                  <div>
                    <h3 className="font-medium text-gray-900 dark:text-white">
                      {call.customerName}
                    </h3>
                    <p className="text-sm text-gray-500">{call.phoneNumber}</p>
                  </div>
                </div>
                <Badge color={getStatusColor(call.status)}>
                  {getStatusLabel(call.status)}
                </Badge>
              </div>

              <div className="grid grid-cols-2 gap-4 mb-3">
                <div>
                  <p className="text-xs text-gray-500 mb-1">Agente</p>
                  <p className="text-sm font-medium">{call.agentName}</p>
                </div>
                <div>
                  <p className="text-xs text-gray-500 mb-1">Duración</p>
                  <p className="text-sm">{formatDuration(call.duration)}</p>
                </div>
              </div>

              <div className="grid grid-cols-2 gap-4 mb-4">
                <div>
                  <p className="text-xs text-gray-500 mb-1">Resultado</p>
                  <Badge color={getOutcomeColor(call.outcome)} size="sm">
                    {getOutcomeLabel(call.outcome)}
                  </Badge>
                </div>
                <div>
                  <p className="text-xs text-gray-500 mb-1">Costo</p>
                    <p className="text-sm font-medium">
                      {(() => {
                        const c = (call as any).costs || {};
                        const amount = Number(c.total_with_markup_cop ?? c.total_cop ?? 0);
                        return `COP ${amount.toFixed(2)}`;
                      })()}
                    </p>
                      <p className="text-xs text-gray-500">
                        {(() => {
                          const c = (call as any).costs || {};
                          const el = Number(c.elevenlabs_cop ?? 0).toFixed(2);
                          const tw = Number(c.twilio_cop ?? 0).toFixed(2);
                          return `ElevenLabs: COP ${el} | Twilio: COP ${tw}`;
                        })()}
                      </p>
                </div>
              </div>

              <div className="flex justify-between items-center">
                <span className="text-xs text-gray-500">
                  {new Date(call.startTime).toLocaleString()}
                </span>
                <Button 
                  size="xs" 
                  onClick={() => handleViewCall(call)}
                  className="bg-blue-600 hover:bg-blue-700"
                >
                  Ver Detalles
                </Button>
              </div>
            </Card>
          ))}
        </div>

         {/* Paginación inferior */}
         {(pagination.total || 0) > pagination.pageSize && (
           <div className="flex flex-col sm:flex-row items-center justify-between gap-4 mt-4 p-4">
             <div className="text-sm text-gray-500">
               Mostrando {(pagination.currentPage - 1) * pagination.pageSize + 1} a {Math.min(pagination.currentPage * pagination.pageSize, pagination.total || calls.length)} de {pagination.total || calls.length} resultados
             </div>
             <div className="flex items-center gap-2">
               <Button
                 size="sm"
                 color="light"
                 disabled={pagination.currentPage === 1}
                 onClick={() => loadConversations(false, undefined, pagination.currentPage - 1)}
                 className="rounded-[10px]"
               >
                 Anterior
               </Button>
               <span className="flex items-center px-3 text-sm bg-white dark:bg-darkgray shadow-md dark:shadow-none rounded-[10px]">
                 Página {pagination.currentPage}
               </span>
               <Button
                 size="sm"
                 color="light"
                 disabled={!pagination.hasMore}
                 onClick={() => loadConversations(false, undefined, pagination.currentPage + 1)}
                 className="rounded-[10px]"
               >
                 Siguiente
               </Button>
             </div>
           </div>
         )}
      </Card>

      {/* Modal de detalles - MEJORADO con padding y colores */}
      <Modal 
        show={isDetailDrawerOpen} 
        onClose={() => {
          // detener y limpiar audio al cerrar
          cleanupAudio();
          setIsDetailDrawerOpen(false);
          setSelectedCall(null);
          setActiveTab('overview');
        }}
        size="6xl"
        className="call-history-modal"
      >
        <Modal.Header>
          <Icon icon="solar:phone-calling-rounded-bold-duotone" className="w-5 h-5 mr-2" />
          {selectedCall ? `Conversación con ${selectedCall.customerName}` : 'Detalles de Conversación'}
        </Modal.Header>
        <Modal.Body className="p-6 max-h-[80vh] overflow-y-auto">
          {selectedCall && (
            <div className="h-full flex flex-col gap-6">
              {/* Header con información básica */}
              <div className="bg-gray-50 dark:bg-gray-800 rounded-lg p-6 border border-gray-200 dark:border-gray-700">
                <div className="flex items-center justify-between mb-4">
                  <div className="flex items-center gap-4">
                    <div className="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center">
                      <Icon icon="solar:user-circle-bold-duotone" className="w-6 h-6 text-blue-600 dark:text-blue-400" />
                    </div>
                    <div>
                      <h3 className="font-semibold text-lg text-gray-900 dark:text-white">{selectedCall.customerName}</h3>
                      <p className="text-gray-600 dark:text-gray-400">{selectedCall.phoneNumber}</p>
                    </div>
                  </div>
                  <div className="text-right">
                    <Badge color={getStatusColor(selectedCall.status)} size="lg">
                      {getStatusLabel(selectedCall.status)}
                    </Badge>
                  </div>
                </div>

                <div className="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                  <div>
                    <p className="text-gray-500 dark:text-gray-400 mb-1">Agente</p>
                    <p className="font-medium text-gray-900 dark:text-white">{selectedCall.agentName}</p>
                  </div>
                  <div>
                    <p className="text-gray-500 dark:text-gray-400 mb-1">Duración</p>
                    <p className="font-medium text-gray-900 dark:text-white">{formatDuration(selectedCall.duration)}</p>
                  </div>
                  <div>
                    <p className="text-gray-500 dark:text-gray-400 mb-1">Costo</p>
                    <p className="font-medium text-gray-900 dark:text-white">
                      {(() => {
                        const c = (selectedCall as any).costs || {};
                        const amount = Number(c.total_with_markup_cop ?? c.total_cop ?? 0);
                        return `COP ${amount.toFixed(2)}`;
                      })()}
                    </p>
                    <p className="text-xs text-gray-500 dark:text-gray-400">
                      {(() => {
                        const c = (selectedCall as any).costs || {};
                        const voice = Number(c.voice_cop ?? 0).toFixed(2);
                        const phone = Number(c.phone_cop ?? 0).toFixed(2);
                        const mins = Number(c.billed_minutes ?? 0);
                        return `Voz IA: COP ${voice} | Telefonía: COP ${phone} (${mins} min)`;
                      })()}
                    </p>
                  </div>
                  <div>
                    <p className="text-gray-500 dark:text-gray-400 mb-1">Fecha</p>
                    <p className="font-medium text-gray-900 dark:text-white">{new Date(selectedCall.startTime).toLocaleDateString()}</p>
                    <p className="text-gray-500 dark:text-gray-400 text-xs">{new Date(selectedCall.startTime).toLocaleTimeString()}</p>
                  </div>
                </div>
              </div>

              {/* Reproductor de Audio - MEJORADO */}
              {(selectedCall.conversation_id || selectedCall.hasAudio) && (
                <div className="rounded-lg p-4 border bg-white border-gray-200 text-gray-900 dark:bg-gray-900 dark:border-gray-700 dark:text-white">
                  <div className="flex items-center gap-3">
                    <Button
                      onClick={() => currentAudio ? togglePlayPause() : handlePlayAudio(selectedCall)}
                      disabled={isLoadingAudio}
                      className="rounded-full w-10 h-10 flex items-center justify-center p-0 transition-all duration-200 shadow-md bg-gray-100 text-gray-900 hover:bg-gray-200 dark:bg-gray-800 dark:text-white dark:hover:bg-gray-700"
                    >
                      {isLoadingAudio ? (
                        <Spinner size="sm" />
                      ) : isPlayingAudio ? (
                        <Icon icon="solar:pause-bold" className="w-5 h-5" />
                      ) : (
                        <Icon icon="solar:play-bold" className="w-5 h-5 ml-0.5" />
                      )}
                    </Button>

                    <Button
                      onClick={() => skipSeconds(-10)}
                      color="light"
                      size="xs"
                      className="border border-gray-200 text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800"
                    >
                      -10s
                    </Button>

                    <div className="flex-1 flex flex-col">
                      <div
                        ref={progressBarRef}
                        onMouseDown={handleProgressBarMouseDown}
                        onTouchStart={handleProgressBarTouchStart}
                        className={`w-full h-2 rounded-full relative cursor-pointer ${isLoadingAudio || !currentAudio ? 'opacity-50 cursor-not-allowed' : ''} bg-gray-200 dark:bg-gray-700`}
                      >
                        <div
                          className="absolute top-0 left-0 h-2 rounded-full bg-gradient-to-r from-blue-500 to-purple-500"
                          style={{ width: `${Math.min(100, Math.max(0, (currentTime / Math.max(1, audioDuration || selectedCall.duration || 1)) * 100))}%` }}
                        />
                      </div>
                      <div className="flex justify-between text-xs mt-1 text-gray-600 dark:text-gray-300">
                        <span>{formatDuration(Math.floor(currentTime))}</span>
                        <span>{formatDuration(Math.floor(audioDuration || selectedCall.duration))}</span>
                      </div>
                    </div>

                    <Button
                      onClick={() => skipSeconds(10)}
                      color="light"
                      size="xs"
                      className="border border-gray-200 text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800"
                    >
                      +10s
                    </Button>

                    <div className="flex items-center gap-2">
                      <Icon icon="solar:volume-loud-bold-duotone" className="w-4 h-4 text-gray-700 dark:text-gray-200" />
                      <div
                        ref={volumeBarRef}
                        onMouseDown={handleVolumeBarMouseDown}
                        onTouchStart={handleVolumeBarTouchStart}
                        className="w-24 h-2 rounded-full relative cursor-pointer bg-gray-200 dark:bg-gray-700"
                      >
                        <div
                          className="absolute top-0 left-0 h-2 rounded-full bg-gradient-to-r from-blue-500 to-purple-500"
                          style={{ width: `${Math.min(100, Math.max(0, volume * 100))}%` }}
                        />
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {/* Tabs de contenido */}
              <div className="flex-1 flex flex-col">
                <div className="border-b border-gray-200 dark:border-gray-700 mb-6">
                  <nav className="-mb-px flex gap-8">
                    {[
                      { id: 'overview', label: 'Visión General', icon: 'solar:eye-bold-duotone' },
                      { id: 'transcript', label: 'Transcripción', icon: 'solar:chat-round-bold-duotone' },
                      { id: 'customer', label: 'Datos del Cliente', icon: 'solar:user-bold-duotone' },
                      { id: 'analysis', label: 'Análisis', icon: 'solar:chart-bold-duotone' }
                    ].map(tab => (
                      <button
                        key={tab.id}
                        onClick={() => setActiveTab(tab.id)}
                        className={`group inline-flex items-center gap-2 py-3 px-1 border-b-2 font-medium text-sm transition-colors ${
                          activeTab === tab.id
                            ? 'border-blue-500 text-blue-600 dark:text-blue-400'
                            : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 dark:hover:border-gray-600'
                        }`}
                      >
                        <Icon icon={tab.icon} className="w-4 h-4" />
                        {tab.label}
                      </button>
                    ))}
                  </nav>
                </div>

                {/* Contenido de tabs - SIN space-y para evitar margin-top */}
                <div className="flex-1 overflow-y-auto">
                  {activeTab === 'overview' && (
                    <div className="flex flex-col gap-6">
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div className="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
                          <h4 className="font-medium mb-4 flex items-center gap-2 text-gray-900 dark:text-white">
                            <Icon icon="solar:info-circle-bold-duotone" className="w-5 h-5 text-blue-500 dark:text-blue-400" />
                            Información General
                          </h4>
                          <div className="flex flex-col gap-3 text-sm">
                            <div className="flex items-center justify-between">
                              <span className="text-gray-600 dark:text-gray-400 font-medium">Estado:</span>
                              <Badge color={getStatusColor(selectedCall.status)} size="sm">{getStatusLabel(selectedCall.status)}</Badge>
                            </div>
                            <div className="flex items-center justify-between">
                              <span className="text-gray-600 dark:text-gray-400 font-medium">Resultado:</span>
                              <Badge color={getOutcomeColor(selectedCall.outcome)} size="sm">{getOutcomeLabel(selectedCall.outcome)}</Badge>
                            </div>
                            <div className="flex items-center justify-between">
                              <span className="text-gray-600 dark:text-gray-400 font-medium">Mensajes:</span>
                              <span className="text-gray-900 dark:text-white">{selectedCall.messageCount || 0}</span>
                            </div>
                            <div className="flex items-center justify-between">
                              <span className="text-gray-600 dark:text-gray-400 font-medium">Sentimiento:</span>
                              <Badge color={selectedCall.sentiment === 'positive' ? 'success' : selectedCall.sentiment === 'negative' ? 'failure' : 'warning'} size="sm">
                                {selectedCall.sentiment === 'positive' ? 'Positivo' : selectedCall.sentiment === 'negative' ? 'Negativo' : 'Neutral'}
                              </Badge>
                            </div>
                            {selectedCall.terminationReason && (
                              <div className="flex items-center justify-between">
                                <span className="text-gray-600 dark:text-gray-400 font-medium">Finalización:</span>
                                <span className="text-gray-900 dark:text-white text-xs">{selectedCall.terminationReason}</span>
                              </div>
                            )}
                          </div>
                        </div>

                        <div className="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
                          <h4 className="font-medium mb-4 flex items-center gap-2 text-gray-900 dark:text-white">
                            <Icon icon="solar:dollar-minimalistic-bold-duotone" className="w-5 h-5 text-green-500 dark:text-green-400" />
                            Costos y Métricas
                          </h4>
                          <div className="flex flex-col gap-3 text-sm">
                          <div className="flex items-center justify-between">
                            <span className="text-gray-600 dark:text-gray-400 font-medium">Costo Total:</span>
                            <span className="text-gray-900 dark:text-white font-semibold">
                              {(() => { const c = (selectedCall as any).costs || {}; const amount = Number(c.total_with_markup_cop ?? c.total_cop ?? 0); return `COP ${amount.toFixed(2)}`; })()}
                            </span>
                            <span className="text-xs text-gray-500 dark:text-gray-400">(Voz IA + Telefonía + Operación)</span>
                          </div>
                          <div className="flex items-center justify-between">
                            <span className="text-gray-600 dark:text-gray-400 font-medium">Voz IA:</span>
                            <span className="text-gray-900 dark:text-white">{(() => { const c = (selectedCall as any).costs || {}; const voice = Number(c.voice_cop ?? 0).toFixed(2); return `COP ${voice}`; })()}</span>
                          </div>
                          <div className="flex items-center justify-between">
                            <span className="text-gray-600 dark:text-gray-400 font-medium">Telefonía:</span>
                            <span className="text-gray-900 dark:text-white">{(() => { const c = (selectedCall as any).costs || {}; const phone = Number(c.phone_cop ?? 0).toFixed(2); return `COP ${phone}`; })()}</span>
                            <span className="text-xs text-gray-500 dark:text-gray-400">
                              ({(() => { const c = (selectedCall as any).costs || {}; return Number(c.billed_minutes ?? 0); })()} min facturados)
                            </span>
                          </div>
                            <div className="flex items-center justify-between">
                              <span className="text-gray-600 dark:text-gray-400 font-medium">Costo operativo:</span>
                              <span className="text-green-600 dark:text-green-400 font-semibold">
                              {(() => { const c = (selectedCall as any).costs || {}; const baseUsd = Number(c.total_usd ?? 0); const markup = Number(c.markup_percent ?? 0); const trm = Number(c.cop_rate ?? 4500); const profitCop = baseUsd * (markup / 100) * trm; return `COP ${profitCop.toFixed(2)}`; })()}
                              </span>
                              <span className="text-xs text-green-500 dark:text-green-400">({(() => { const c = (selectedCall as any).costs || {}; return Number(c.markup_percent ?? 40); })()}%)</span>
                            </div>
                            <div className="flex items-center justify-between">
                              <span className="text-gray-600 dark:text-gray-400 font-medium">Duración:</span>
                              <span className="text-gray-900 dark:text-white font-semibold">{formatDuration(selectedCall.duration)}</span>
                            </div>
                            <div className="flex items-center justify-between">
                              <span className="text-gray-600 dark:text-gray-400 font-medium">Inicio:</span>
                              <span className="text-gray-900 dark:text-white text-xs">{new Date(selectedCall.startTime).toLocaleString()}</span>
                            </div>
                            {selectedCall.endTime && (
                              <div className="flex items-center justify-between">
                                <span className="text-gray-600 dark:text-gray-400 font-medium">Fin:</span>
                                <span className="text-gray-900 dark:text-white text-xs">{new Date(selectedCall.endTime).toLocaleString()}</span>
                              </div>
                            )}
                          </div>
                        </div>
                      </div>

                      {selectedCall.tags && selectedCall.tags.length > 0 && (
                        <div className="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
                          <h4 className="font-medium mb-4 text-gray-900 dark:text-white">Etiquetas</h4>
                          <div className="flex flex-wrap gap-2">
                            {selectedCall.tags.map((tag, index) => (
                              <Badge key={index} color="info" size="sm">{tag}</Badge>
                            ))}
                          </div>
                        </div>
                      )}

                      {selectedCall.notes && (
                        <div className="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-6">
                          <h4 className="font-medium mb-3 text-yellow-800 dark:text-yellow-200">Notas de la Conversación</h4>
                          <p className="text-sm text-yellow-700 dark:text-yellow-300">{selectedCall.notes}</p>
                        </div>
                      )}
                    </div>
                  )}

                  {activeTab === 'transcript' && (
                    <div className="h-full flex flex-col gap-6">
                      {Array.isArray(selectedCall.transcript) && selectedCall.transcript.length > 0 ? (
                        <>
                          {/* Header del chat */}
                          <div className="bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900/20 dark:to-purple-900/20 rounded-lg p-6 border border-blue-200 dark:border-blue-800">
                            <div className="flex items-center justify-between">
                              <div className="flex items-center gap-4">
                                <div className="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center">
                                  <Icon icon="solar:chat-round-call-bold-duotone" className="w-6 h-6 text-green-600 dark:text-green-400" />
                                </div>
                                <div>
                                  <h3 className="font-semibold text-lg text-gray-900 dark:text-white">Conversación en Tiempo Real</h3>
                                  <p className="text-sm text-gray-600 dark:text-gray-400">
                                    {selectedCall.messageCount || selectedCall.transcript.length} mensajes • {formatDuration(selectedCall.duration)}
                                  </p>
                                </div>
                              </div>
                              <Badge color="success" size="lg">Completada</Badge>
                            </div>
                          </div>

                          {/* Mensajes estilo chat mejorados */}
                          <div className="bg-gray-50 dark:bg-gray-800 rounded-lg p-6 max-h-96 overflow-y-auto border border-gray-200 dark:border-gray-700">
                            <div className="flex flex-col gap-4">
                       {selectedCall.transcript.map((message, _index) => (
                                <div key={_index} className={`flex gap-4 ${message.role === 'user' ? 'flex-row-reverse' : ''}`}>
                                  {/* Avatar mejorado */}
                                  <div className={`w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 ${
                                    message.role === 'agent' 
                                      ? 'bg-gradient-to-br from-blue-500 to-blue-600 shadow-lg' 
                                      : 'bg-gradient-to-br from-green-500 to-green-600 shadow-lg'
                                  }`}>
                                    <Icon 
                                      icon={message.role === 'agent' ? 'solar:chat-round-bold-duotone' : 'solar:user-bold-duotone'} 
                                      className="w-5 h-5 text-white" 
                                    />
                                  </div>

                                  {/* Mensaje mejorado */}
                                  <div className={`flex-1 ${message.role === 'user' ? 'text-right' : ''}`}>
                                    <div className={`inline-block max-w-[85%] p-4 rounded-2xl shadow-sm ${
                                      message.role === 'agent'
                                        ? 'bg-white dark:bg-gray-700 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-600'
                                        : 'bg-blue-500 dark:bg-blue-600 text-white'
                                    }`}>
                                      <p className="text-sm leading-relaxed">{message.message}</p>
                                      
                                      {/* Metadatos del mensaje mejorados */}
                                      <div className={`flex items-center gap-2 mt-3 text-xs ${
                                        message.role === 'agent' ? 'text-gray-500 dark:text-gray-400' : 'text-blue-100'
                                      }`}>
                                        <Icon icon="solar:clock-circle-bold-duotone" className="w-3 h-3" />
                                        <span className="font-medium">
                                          {Math.floor(message.time_in_call_secs / 60)}:{String(message.time_in_call_secs % 60).padStart(2, '0')}
                                        </span>
                                        
                                        {message.source_medium && (
                                          <>
                                            <span className="opacity-60">•</span>
                                            <Icon icon="solar:microphone-3-bold-duotone" className="w-3 h-3" />
                                            <span>{message.source_medium}</span>
                                          </>
                                        )}

                                        {message.tool_calls && message.tool_calls.length > 0 && (
                                          <>
                                            <span className="opacity-60">•</span>
                                            <Icon icon="solar:settings-bold-duotone" className="w-3 h-3" />
                                            <span>{message.tool_calls.length} herramienta{message.tool_calls.length > 1 ? 's' : ''}</span>
                                          </>
                                        )}

                                        {message.feedback && (
                                          <>
                                            <span className="opacity-60">•</span>
                                            <Icon 
                                              icon={message.feedback.score === 'like' ? 'solar:like-bold-duotone' : 'solar:dislike-bold-duotone'} 
                                              className={`w-3 h-3 ${message.feedback.score === 'like' ? 'text-green-500' : 'text-red-500'}`}
                                            />
                                          </>
                                        )}
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              ))}
                            </div>
                          </div>

                          {/* Estadísticas de la conversación mejoradas */}
                          <div className="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
                            <h4 className="font-semibold mb-4 text-gray-900 dark:text-white">Estadísticas de la Conversación</h4>
                            <div className="grid grid-cols-2 md:grid-cols-4 gap-6 text-sm">
                              <div className="text-center bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4">
                                <div className="text-3xl font-bold text-blue-600 dark:text-blue-400 mb-1">{selectedCall.transcript.length}</div>
                                <div className="text-gray-600 dark:text-gray-400 font-medium">Intercambios</div>
                              </div>
                              <div className="text-center bg-green-50 dark:bg-green-900/20 rounded-lg p-4">
                                <div className="text-3xl font-bold text-green-600 dark:text-green-400 mb-1">
                                  {selectedCall.transcript.filter(m => m.role === 'agent').length}
                                </div>
                                <div className="text-gray-600 dark:text-gray-400 font-medium">Mensajes Agente</div>
                              </div>
                              <div className="text-center bg-purple-50 dark:bg-purple-900/20 rounded-lg p-4">
                                <div className="text-3xl font-bold text-purple-600 dark:text-purple-400 mb-1">
                                  {selectedCall.transcript.filter(m => m.role === 'user').length}
                                </div>
                                <div className="text-gray-600 dark:text-gray-400 font-medium">Mensajes Cliente</div>
                              </div>
                              <div className="text-center bg-orange-50 dark:bg-orange-900/20 rounded-lg p-4">
                                <div className="text-3xl font-bold text-orange-600 dark:text-orange-400 mb-1">
                                  {selectedCall.transcript.filter(m => m.tool_calls && m.tool_calls.length > 0).length}
                                </div>
                                <div className="text-gray-600 dark:text-gray-400 font-medium">Herramientas</div>
                              </div>
                            </div>
                          </div>
                        </>
                      ) : typeof selectedCall.transcript === 'string' ? (
                        <div className="bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
                          <h4 className="font-semibold mb-4 text-gray-900 dark:text-white">Transcripción de Texto</h4>
                          <p className="text-sm leading-relaxed whitespace-pre-wrap text-gray-700 dark:text-gray-300">{selectedCall.transcript}</p>
                        </div>
                      ) : (
                        <div className="text-center py-12 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                          <Icon icon="solar:document-text-bold-duotone" className="w-20 h-20 text-gray-300 dark:text-gray-600 mx-auto mb-4" />
                          <p className="text-gray-500 dark:text-gray-400 text-lg">No hay transcripción disponible</p>
                          <p className="text-gray-400 dark:text-gray-500 text-sm mt-2">La transcripción aparecerá cuando se procese la conversación</p>
                        </div>
                      )}
                    </div>
                  )}

                  {activeTab === 'customer' && (
                    <div className="space-y-6">
                      <div className="bg-white dark:bg-gray-800 rounded-lg border p-6">
                        <h4 className="font-medium mb-4 flex items-center gap-2">
                          <Icon icon="solar:user-circle-bold-duotone" className="w-5 h-5 text-blue-500" />
                          Información del Cliente
                        </h4>
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                          <div className="space-y-3">
                            <div>
                              <label className="text-sm font-medium text-gray-700 dark:text-gray-300">Nombre Completo</label>
                              <p className="text-sm text-gray-900 dark:text-white">{selectedCall.customerName}</p>
                            </div>
                            <div>
                              <label className="text-sm font-medium text-gray-700 dark:text-gray-300">Teléfono</label>
                              <p className="text-sm text-gray-900 dark:text-white">{selectedCall.phoneNumber}</p>
                            </div>
                            {selectedCall.customerData?.email && (
                              <div>
                                <label className="text-sm font-medium text-gray-700 dark:text-gray-300">Email</label>
                                <p className="text-sm text-gray-900 dark:text-white">{selectedCall.customerData.email}</p>
                              </div>
                            )}
                          </div>
                          <div className="space-y-3">
                            {selectedCall.customerData?.policyNumber && (
                              <div>
                                <label className="text-sm font-medium text-gray-700 dark:text-gray-300">Número de Póliza</label>
                                <p className="text-sm text-gray-900 dark:text-white">{selectedCall.customerData.policyNumber}</p>
                              </div>
                            )}
                            {selectedCall.customerData?.debtAmount !== undefined && (
                              <div>
                                <label className="text-sm font-medium text-gray-700 dark:text-gray-300">Monto de Deuda</label>
                                <p className="text-sm text-gray-900 dark:text-white">${selectedCall.customerData.debtAmount}</p>
                              </div>
                            )}
                          </div>
                        </div>
                      </div>

                      {/* Datos Recolectados Durante la Llamada */}
                      {(selectedCall as any).collected_data && Object.keys((selectedCall as any).collected_data).length > 0 && (
                        <div className="bg-gradient-to-br from-green-50 to-blue-50 dark:from-green-900/20 dark:to-blue-900/20 rounded-lg border border-green-200 dark:border-green-800 p-6">
                          <h4 className="font-medium mb-4 flex items-center gap-2 text-gray-900 dark:text-white">
                            <Icon icon="solar:database-bold-duotone" className="w-5 h-5 text-green-500 dark:text-green-400" />
                            Datos Recolectados Durante la Llamada
                            <Badge color="success" size="sm">Nuevo</Badge>
                          </h4>
                          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                            {Object.entries((selectedCall as any).collected_data).map(([field, data]: [string, any]) => (
                              <div key={field} className="bg-white dark:bg-gray-800 rounded-lg p-4 border border-gray-200 dark:border-gray-700">
                                <div className="flex items-start justify-between mb-2">
                                  <label className="text-sm font-medium text-gray-700 dark:text-gray-300 capitalize">
                                    {field.replace(/_/g, ' ')}
                                  </label>
                                  <Badge color="success" size="xs">
                                    {Math.round((data.confidence || 0) * 100)}% confianza
                                  </Badge>
                                </div>
                                <p className="text-sm text-gray-900 dark:text-white font-semibold mb-1">
                                  {typeof data.value === 'number' ? data.value : data.value || 'N/A'}
                                </p>
                                <div className="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
                                  <Icon icon="solar:check-circle-bold-duotone" className="w-3 h-3 text-green-500" />
                                  <span>Fuente: {data.source === 'elevenlabs_tool' ? 'Tool de IA' : 'Transcripción'}</span>
                                </div>
                                {data.collected_at && (
                                  <p className="text-xs text-gray-400 dark:text-gray-500 mt-1">
                                    Recolectado: {new Date(data.collected_at).toLocaleString()}
                                  </p>
                                )}
                              </div>
                            ))}
                          </div>
                          
                          {/* Indicador de herramienta usada */}
                          {(selectedCall as any).call_metadata?.tool_used && (
                            <div className="mt-4 flex items-center gap-2 text-sm text-green-600 dark:text-green-400">
                              <Icon icon="solar:verified-check-bold-duotone" className="w-5 h-5" />
                              <span className="font-medium">Datos recolectados automáticamente por el agente de IA</span>
                            </div>
                          )}
                        </div>
                      )}
                    </div>
                  )}

                  {activeTab === 'analysis' && (
                    <div className="space-y-6">
                      {/* Resumen de la conversación */}
                      {((selectedCall as any).call_result?.transcript_summary || (selectedCall as any).elevenlabs_analysis?.transcript_summary) && (
                        <div className="bg-gradient-to-br from-purple-50 to-blue-50 dark:from-purple-900/20 dark:to-blue-900/20 rounded-lg border border-purple-200 dark:border-purple-800 p-6">
                          <h4 className="font-medium mb-4 flex items-center gap-2 text-gray-900 dark:text-white">
                            <Icon icon="solar:document-text-bold-duotone" className="w-5 h-5 text-purple-500 dark:text-purple-400" />
                            Resumen de la Conversación
                          </h4>
                          <div className="bg-white dark:bg-gray-800 rounded-lg p-4 border border-gray-200 dark:border-gray-700">
                            <p className="text-sm leading-relaxed text-gray-700 dark:text-gray-300 whitespace-pre-wrap">
                              {(selectedCall as any).call_result?.transcript_summary || (selectedCall as any).elevenlabs_analysis?.transcript_summary}
                            </p>
                          </div>
                        </div>
                      )}

                      {/* Razón de terminación */}
                      {((selectedCall as any).call_result?.termination_reason || (selectedCall as any).elevenlabs_analysis?.termination_reason) && (
                        <div className="bg-amber-50 dark:bg-amber-900/20 rounded-lg border border-amber-200 dark:border-amber-800 p-4">
                          <div className="flex items-start gap-3">
                            <Icon icon="solar:info-circle-bold-duotone" className="w-5 h-5 text-amber-600 dark:text-amber-400 mt-0.5 flex-shrink-0" />
                            <div>
                              <h5 className="font-medium text-amber-900 dark:text-amber-100 mb-1">Razón de Finalización</h5>
                              <p className="text-sm text-amber-800 dark:text-amber-200">
                                {(selectedCall as any).call_result?.termination_reason || (selectedCall as any).elevenlabs_analysis?.termination_reason}
                              </p>
                            </div>
                          </div>
                        </div>
                      )}

                      {/* Análisis de éxito de la llamada */}
                      {((selectedCall as any).call_result || (selectedCall as any).elevenlabs_analysis) && (
                        <div className="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
                          <h4 className="font-medium mb-4 flex items-center gap-2 text-gray-900 dark:text-white">
                            <Icon icon="solar:chart-bold-duotone" className="w-5 h-5 text-blue-500 dark:text-blue-400" />
                            Análisis de Resultados
                          </h4>
                          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div className="bg-gray-50 dark:bg-gray-900/50 rounded-lg p-4">
                              <div className="flex items-center justify-between mb-2">
                                <span className="text-sm font-medium text-gray-700 dark:text-gray-300">Llamada Exitosa</span>
                                <Badge color={(selectedCall as any).elevenlabs_analysis.call_successful ? 'success' : 'failure'} size="sm">
                                  {(selectedCall as any).elevenlabs_analysis.call_successful ? 'Sí' : 'No'}
                                </Badge>
                              </div>
                            </div>
                            
                            {(selectedCall as any).elevenlabs_analysis.user_sentiment && (
                              <div className="bg-gray-50 dark:bg-gray-900/50 rounded-lg p-4">
                                <div className="flex items-center justify-between mb-2">
                                  <span className="text-sm font-medium text-gray-700 dark:text-gray-300">Sentimiento del Cliente</span>
                                  <Badge
                                    color={
                                      (selectedCall as any).elevenlabs_analysis.user_sentiment === 'positive' ? 'success' :
                                      (selectedCall as any).elevenlabs_analysis.user_sentiment === 'negative' ? 'failure' : 'warning'
                                    }
                                    size="sm"
                                  >
                                    {(selectedCall as any).elevenlabs_analysis.user_sentiment === 'positive' ? 'Positivo' :
                                     (selectedCall as any).elevenlabs_analysis.user_sentiment === 'negative' ? 'Negativo' : 'Neutral'}
                                  </Badge>
                                </div>
                              </div>
                            )}
                          </div>
                        </div>
                      )}

                      {/* Análisis de calidad (legacy) */}
                      {selectedCall.analysis && (
                        <div className="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6">
                          <h4 className="font-medium mb-4 flex items-center gap-2 text-gray-900 dark:text-white">
                            <Icon icon="solar:chart-bold-duotone" className="w-5 h-5 text-purple-500 dark:text-purple-400" />
                            Análisis de Calidad
                          </h4>
                          <div className="space-y-4">
                            <div>
                              <label className="text-sm font-medium text-gray-700 dark:text-gray-300">Puntuación de Calidad</label>
                              <div className="flex items-center gap-3 mt-1">
                                <div className="flex-1 bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                                  <div
                                    className="bg-gradient-to-r from-green-500 to-blue-500 h-2 rounded-full transition-all duration-500"
                                    style={{ width: `${selectedCall.analysis.qualityScore * 100}%` }}
                                  ></div>
                                </div>
                                <span className="text-sm font-medium text-gray-900 dark:text-white">{Math.round(selectedCall.analysis.qualityScore * 100)}%</span>
                              </div>
                            </div>
                            
                            <div>
                              <label className="text-sm font-medium text-gray-700 dark:text-gray-300">Puntos Clave</label>
                              <ul className="mt-2 space-y-2">
                                {selectedCall.analysis.keyPoints.map((point, index) => (
                                  <li key={index} className="flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300">
                                    <Icon icon="solar:check-circle-bold-duotone" className="w-4 h-4 text-green-500 dark:text-green-400 mt-0.5 flex-shrink-0" />
                                    <span>{point}</span>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          </div>
                        </div>
                      )}

                    </div>
                  )}
                </div>
              </div>

            </div>
          )}
        </Modal.Body>
      </Modal>
    </div>
  );
};

export default CallHistory;
