generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// AGENCIAS (multi-tenant)
// ──────────────────────────────────────────────
model Agency {
  id        String   @id @default(cuid())
  name      String
  nit       String?  @unique
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  connections InsurerConnection[]
  policies    Policy[]
  clients     Client[]
  payments    Payment[]
  commissions Commission[]
  syncLogs    SyncLog[]

  @@map("agencies")
}

// ──────────────────────────────────────────────
// USUARIOS
// ──────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  agencyId     String   @map("agency_id")
  email        String   @unique
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name")
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("users")
}

enum UserRole {
  ADMIN
  AGENT
  VIEWER
}

// ──────────────────────────────────────────────
// ASEGURADORAS (catálogo)
// ──────────────────────────────────────────────
model Insurer {
  id          String  @id @default(cuid())
  slug        String  @unique // sura, bolivar, allianz, etc.
  name        String
  logoUrl     String? @map("logo_url")
  website     String?
  isActive    Boolean @default(true) @map("is_active")
  authType    String  @default("cookie") @map("auth_type") // cookie, token, sso, puppeteer
  description String?  @db.Text

  connections InsurerConnection[]
  policies    Policy[]
  payments    Payment[]
  commissions Commission[]

  @@map("insurers")
}

// ──────────────────────────────────────────────
// CONEXIONES agencia <-> aseguradora
// ──────────────────────────────────────────────
model InsurerConnection {
  id              String           @id @default(cuid())
  agencyId        String           @map("agency_id")
  insurerId       String           @map("insurer_id")
  username        String
  passwordEnc     String           @map("password_enc") @db.Text // encrypted
  extraConfig     Json?            @map("extra_config") // additional auth data
  sessionData     Json?            @map("session_data") // cookies, tokens, etc.
  status          ConnectionStatus @default(DISCONNECTED)
  lastSyncAt      DateTime?        @map("last_sync_at")
  lastError       String?          @map("last_error") @db.Text
  autoSync        Boolean          @default(true) @map("auto_sync")
  syncIntervalMin Int              @default(60) @map("sync_interval_min")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  insurer Insurer @relation(fields: [insurerId], references: [id])

  syncLogs SyncLog[]

  @@unique([agencyId, insurerId])
  @@map("insurer_connections")
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  SYNCING
  ERROR
  SESSION_EXPIRED
}

// ──────────────────────────────────────────────
// CLIENTES (unificados cross-aseguradora)
// ──────────────────────────────────────────────
model Client {
  id             String   @id @default(cuid())
  agencyId       String   @map("agency_id")
  documentType   String   @map("document_type") // CC, NIT, CE, PP
  documentNumber String   @map("document_number")
  firstName      String?  @map("first_name")
  lastName       String?  @map("last_name")
  fullName       String   @map("full_name")
  email          String?
  phone          String?
  cellphone      String?
  address        String?
  city           String?
  birthDate      DateTime? @map("birth_date")
  rawData        Json?    @map("raw_data") // original data per insurer
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  policies Policy[]

  @@unique([agencyId, documentType, documentNumber])
  @@map("clients")
}

// ──────────────────────────────────────────────
// PÓLIZAS (unificadas)
// ──────────────────────────────────────────────
model Policy {
  id                    String       @id @default(cuid())
  agencyId              String       @map("agency_id")
  insurerId             String       @map("insurer_id")
  clientId              String?      @map("client_id")
  policyNumber          String       @map("policy_number")
  policyType            String?      @map("policy_type") // individual, colectiva
  branch                String?      // ramo
  branchCode            String?      @map("branch_code")
  product               String?
  productCode           String?      @map("product_code")
  status                PolicyStatus @default(ACTIVE)
  holderName            String?      @map("holder_name")
  holderDocument        String?      @map("holder_document")
  holderDocumentType    String?      @map("holder_document_type")
  insuredName           String?      @map("insured_name")
  insuredDocument       String?      @map("insured_document")
  startDate             DateTime?    @map("start_date")
  endDate               DateTime?    @map("end_date")
  issueDate             DateTime?    @map("issue_date")
  cancellationDate      DateTime?    @map("cancellation_date")
  premium               Float?       // prima
  iva                   Float?
  totalAmount           Float?       @map("total_amount")
  commissionAmount      Float?       @map("commission_amount")
  commissionPercentage  Float?       @map("commission_percentage")
  paymentFrequency      String?      @map("payment_frequency") // mensual, trimestral, etc.
  paymentMethod         String?      @map("payment_method")
  office                String?
  channel               String?
  renewalNumber         Int          @default(0) @map("renewal_number")
  certificateNumber     String?      @map("certificate_number")
  externalId            String?      @map("external_id") // ID in the insurer's system
  rawData               Json?        @map("raw_data")
  lastSyncAt            DateTime?    @map("last_sync_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  insurer     Insurer      @relation(fields: [insurerId], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id])
  payments    Payment[]
  commissions Commission[]

  @@unique([agencyId, insurerId, policyNumber, renewalNumber])
  @@index([agencyId, status])
  @@index([agencyId, insurerId])
  @@index([holderDocument])
  @@map("policies")
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
  SUSPENDED
}

// ──────────────────────────────────────────────
// PAGOS / CARTERA
// ──────────────────────────────────────────────
model Payment {
  id                String        @id @default(cuid())
  agencyId          String        @map("agency_id")
  insurerId         String        @map("insurer_id")
  policyId          String        @map("policy_id")
  paymentNumber     Int           @map("payment_number") // cuota #
  totalPayments     Int?          @map("total_payments") // total cuotas
  amountDue         Float         @map("amount_due")
  amountPaid        Float         @default(0) @map("amount_paid")
  balance           Float         @default(0)
  dueDate           DateTime?     @map("due_date")
  paidDate          DateTime?     @map("paid_date")
  status            PaymentStatus @default(PENDING)
  collectionType    String?       @map("collection_type") // oficina, aseguradora, directo
  collectedAtOffice Boolean       @default(false) @map("collected_at_office")
  paidToInsurer     Boolean       @default(false) @map("paid_to_insurer")
  receiptNumber     String?       @map("receipt_number")
  externalId        String?       @map("external_id")
  rawData           Json?         @map("raw_data")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  insurer Insurer @relation(fields: [insurerId], references: [id])
  policy  Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, paymentNumber])
  @@index([agencyId, status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

// ──────────────────────────────────────────────
// COMISIONES
// ──────────────────────────────────────────────
model Commission {
  id                   String           @id @default(cuid())
  agencyId             String           @map("agency_id")
  insurerId            String           @map("insurer_id")
  policyId             String           @map("policy_id")
  commissionAmount     Float            @map("commission_amount")
  commissionPercentage Float?           @map("commission_percentage")
  status               CommissionStatus @default(PENDING)
  expectedDate         DateTime?        @map("expected_date")
  receivedDate         DateTime?        @map("received_date")
  period               String?          // "2026-03", "2026-Q1"
  externalId           String?          @map("external_id")
  rawData              Json?            @map("raw_data")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  insurer Insurer @relation(fields: [insurerId], references: [id])
  policy  Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([agencyId, status])
  @@index([agencyId, insurerId])
  @@map("commissions")
}

enum CommissionStatus {
  PENDING
  RECEIVED
  PARTIAL
}

// ──────────────────────────────────────────────
// SYNC LOGS
// ──────────────────────────────────────────────
model SyncLog {
  id           String    @id @default(cuid())
  agencyId     String    @map("agency_id")
  connectionId String    @map("connection_id")
  syncType     String    @map("sync_type") // policies, clients, payments, commissions, full
  status       SyncStatus @default(RUNNING)
  itemsSynced  Int       @default(0) @map("items_synced")
  itemsFailed  Int       @default(0) @map("items_failed")
  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  metadata     Json?

  agency     Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  connection InsurerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([agencyId, connectionId])
  @@map("sync_logs")
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
